{
  "name": "lifestore",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bash scripts/check.sh",
    "db:migrate": "pnpm --filter @lifestore/api db:migrate",
    "db:generate": "pnpm --filter @lifestore/api db:generate",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
