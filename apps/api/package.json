{
  "name": "@lifestore/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lifestore/domain": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^12.1.2",
    "drizzle-orm": "^0.44.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
